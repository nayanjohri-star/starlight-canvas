#usda 1.0
(
    defaultPrim = "Camera"
    metersPerUnit = 1
    upAxis = "Y"
    timeCodesPerSecond = 24
    startTimeCode = 12
    endTimeCode = 14
)

# UsdGeomCamera optical lengths are tenths of a stage unit. On this metre
# stage the schema values are millimetres / 100; cozyclay:*Mm records the
# authored millimetres explicitly.
def Camera "Camera"
{
    custom float cozyclay:focalLengthMm = 50
    custom float cozyclay:focalLengthMm.timeSamples = {
        12: 50,
        13: 65,
        14: 85,
    }
    custom float cozyclay:horizontalApertureMm = 36
    custom string cozyclay:sensorId = "fullFrame"
    custom float cozyclay:verticalApertureMm = 20.25
    float focalLength = 0.5
    float focalLength.timeSamples = {
        12: 0.5,
        13: 0.65,
        14: 0.85,
    }
    float horizontalAperture = 0.36
    token projection = "perspective"
    float verticalAperture = 0.2025
    quatf xformOp:orient = (0.951251242564198, 0.167731259496521, 0.254887002244179, -0.0449434555275478)
    quatf xformOp:orient.timeSamples = {
        12: (0.951251242564198, 0.167731259496521, 0.254887002244179, -0.0449434555275478),
        13: (0.915975615036753, 0.12059047744874, 0.37940952255126, -0.0499502112523148),
        14: (0.696364240320019, 0.122787803968973, 0.696364240320019, -0.122787803968973),
    }
    double3 xformOp:translate = (1, 2, 3)
    double3 xformOp:translate.timeSamples = {
        12: (1, 2, 3),
        13: (1.5, 2.25, 2.5),
        14: (2, 2.5, 2),
    }
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
}
